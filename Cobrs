import pygame
import random
import sys
import os

pygame.init()

# ===================== TELA =====================
info = pygame.display.Info()
LARGURA = info.current_w
ALTURA = info.current_h

tela = pygame.display.set_mode((LARGURA, ALTURA), pygame.FULLSCREEN)
pygame.display.set_caption("Cobrinha Infinita PRO")

clock = pygame.time.Clock()

# ===================== CORES =====================
PRETO = (0, 0, 0)
BRANCO = (255, 255, 255)
VERMELHO = (255, 60, 60)

CINZA1 = (30, 30, 30)
CINZA2 = (45, 45, 45)

temas = {

    "Dark": {
        "fundo": (10, 10, 15),
        "c1": (25, 25, 35),
        "c2": (45, 45, 55),
        "borda": (230, 230, 230)
    },

    "Grama": {
        "fundo": (5, 35, 5),
