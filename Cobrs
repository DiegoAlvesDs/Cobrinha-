        "c2": (30, 110, 30),
        "borda": (200, 255, 200)
    },

    "Oceano": {
        "fundo": (0, 15, 40),
        "c1": (0, 45, 90),
        "c2": (0, 80, 130),
        "borda": (180, 230, 255)
    },

    "Lava": {
        "fundo": (30, 5, 5),
        "c1": (90, 20, 20),
        "c2": (130, 40, 10),
        "borda": (255, 200, 100)
    },

    "Galaxia": {
        "fundo": (5, 5, 25),
        "c1": (20, 15, 60),
